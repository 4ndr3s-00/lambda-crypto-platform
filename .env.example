# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: PLATAFORMA DE DATOS LAMBDA (CRIPTOMONEDAS Y FINANZAS)
# Copia este archivo a .env antes de levantar Docker Compose: cp .env.example .env
# ==============================================================================

# Proyecto y Entorno
COMPOSE_PROJECT_NAME=lambda-crypto-platform
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 1. MinIO (S3 Compatible Data Lake - Organización Funcional sin Medallion)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000

# Buckets funcionales
MINIO_BUCKET_LAKE=market-lake
MINIO_BUCKET_CHECKPOINTS=market-checkpoints
MINIO_BUCKET_QUARANTINE=market-quarantine

# Credenciales de Servicio MinIO (Mínimo Privilegio - US-03)
SPARK_MINIO_USER=spark_service
SPARK_MINIO_PASSWORD=spark_secure_lake_pass123
AIRFLOW_MINIO_USER=airflow_service
AIRFLOW_MINIO_PASSWORD=airflow_secure_lake_pass123
API_MINIO_USER=api_service
API_MINIO_PASSWORD=api_secure_serving_pass123

# ------------------------------------------------------------------------------
# 2. Apache Kafka (KRaft Mode - Bus de Eventos)
# ------------------------------------------------------------------------------
KAFKA_CLUSTER_ID=4L622nShT-2xMVuLqW6q3w
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_BROKER_LIST=kafka:9092

# Topics principales
KAFKA_TOPIC_EVENTS=market.events
KAFKA_TOPIC_OHLCV=market.ohlcv
KAFKA_TOPIC_METRICS=market.metrics
KAFKA_TOPIC_DLQ=market.dlq

# ------------------------------------------------------------------------------
# 3. PostgreSQL (Metadatos de Servicios y Almacén de Serving - US-04)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=market_platform
POSTGRES_PORT=5432

# Bases de datos y usuarios dedicados (Criterio 1 BDD US-04)
AIRFLOW_DB_NAME=airflow_db
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=airflow_secure_pass123

SERVING_DB_NAME=serving_db
SERVING_DB_USER=serving_user
SERVING_DB_PASSWORD=serving_secure_pass123

METASTORE_DB_NAME=metastore_db
METASTORE_DB_USER=metastore_user
METASTORE_DB_PASSWORD=metastore_secure_pass123

# ------------------------------------------------------------------------------
# 4. Apache Spark (Batch & Speed Layers)
# ------------------------------------------------------------------------------
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
# En Windows, Docker Desktop puede ocupar 8081. Si falla el bind, usar 8082.
SPARK_WORKER_WEBUI_PORT=8081
# Último puerto del rango publicado para las Web UI de los workers escalados
# (make scale-spark). Debe ser >= SPARK_WORKER_WEBUI_PORT.
SPARK_WORKER_WEBUI_PORT_MAX=8084
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1G
SPARK_DRIVER_MEMORY=1G

# ------------------------------------------------------------------------------
# 5. Apache Airflow (Orquestación Batch)
# ------------------------------------------------------------------------------
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=andres@local.dev
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ------------------------------------------------------------------------------
# 6. Serving Layer (FastAPI & Dashboard)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8000

# ------------------------------------------------------------------------------
# 7. LLM Local Qwen2.5 (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://ollama:11434

# ------------------------------------------------------------------------------
# 8. OpenMetadata & OpenSearch (Catálogo, Linaje y Calidad - US-25)
# ------------------------------------------------------------------------------
OPENSEARCH_PORT=9200
OPENMETADATA_PORT=8585
OPENMETADATA_DB=openmetadata_db
OPENMETADATA_SERVER_URL=http://localhost:8585

OLLAMA_TIMEOUT_SECONDS=60
RAG_INDEX_PATH=/app/metadata/rag_index.json


# Fuente de mercado real (espejo público de Binance)
BINANCE_API_BASE=https://data-api.binance.vision
MARKET_CACHE_TTL_SECONDS=5
MARKET_REQUEST_TIMEOUT_SECONDS=5

