{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAirflowBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::market-lake",
        "arn:aws:s3:::market-quarantine"
      ]
    },
    {
      "Sid": "AllowAirflowMarketLakeFullAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::market-lake/*"
      ]
    },
    {
      "Sid": "AllowAirflowQuarantineReadAudit",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::market-quarantine/*"
      ]
    }
  ]
}
