{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowApiBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::market-lake"
      ]
    },
    {
      "Sid": "AllowApiReadBatchResultsAndReference",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::market-lake/batch-results/*",
        "arn:aws:s3:::market-lake/batch-results",
        "arn:aws:s3:::market-lake/reference/*",
        "arn:aws:s3:::market-lake/reference"
      ]
    }
  ]
}
